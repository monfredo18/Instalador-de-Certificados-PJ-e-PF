{
  "name": "@cert-ecosystem/cadastrador",
  "version": "1.0.0",
  "description": "Gerenciador de Certificados Digitais",
  "author": "Viriato Contabil",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "clean": "rimraf dist dist-electron"
  },
  "build": {
    "appId": "com.certecosystem.cadastrador",
    "productName": "Cadastrador de Certificados",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "portable": {
      "artifactName": "Cadastrador-de-Certificados.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cadastrador de Certificados"
    }
  },
  "dependencies": {
    "@cert-ecosystem/shared-core": "*",
    "@cert-ecosystem/shared-types": "*",
    "@cert-ecosystem/shared-ui": "*",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
